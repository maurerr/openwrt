#!/bin/sh /etc/rc.common
# ROOter 25.12: dnsmasq domain -> nftset helper
# Keeps the historical dnsmasq-ipset UCI interface while using fw4/nftables.

START=55

DNSMASQ="/etc/dnsmasq.conf"
FIREWALL_CONFIG="/etc/config/firewall"

ensure_nftset() {
    local name="$1"
    [ -n "$name" ] || return 1

    # fw4 creates the nft set from this UCI section.
    if ! uci -q show firewall | grep -q "name='${name}'"; then
        local section
        section="$(uci add firewall ipset)"
        uci set firewall."$section".name="$name"
        uci set firewall."$section".family="ipv4"
        uci add_list firewall."$section".match="dest_ip"
        uci set firewall."$section".enabled="1"
        uci commit firewall
    fi
}

gen_config_file() {
    local section="$1"
    local ipset_name enabled ipline domain

    config_get ipset_name "$section" "ipset_name"
    [ -n "$ipset_name" ] || return 0

    # Remove the block generated by this package on previous runs.
    sed -i "/#${ipset_name}-1/,/#${ipset_name}-2/d" "$DNSMASQ"

    config_get enabled "$section" "enabled"
    [ -n "$enabled" ] || enabled=0
    [ "$enabled" -eq 1 ] || return 0

    ensure_nftset "$ipset_name" || return 1

    ipline="nftset=/"
    handle_domain() {
        domain="$1"
        ipline="${ipline}${domain}/"
    }

    echo "#${ipset_name}-1" >> "$DNSMASQ"
    config_list_foreach "$section" "managed_domain" handle_domain
    echo "${ipline}4#inet#fw4#${ipset_name}" >> "$DNSMASQ"
    echo "#${ipset_name}-2" >> "$DNSMASQ"
}

gen_config_files() {
    config_load 'dnsmasq-ipset'
    config_foreach gen_config_file 'ipsets'
    /etc/init.d/firewall reload
    /etc/init.d/dnsmasq reload
}

start() {
    gen_config_files
}

reload() {
    sleep 5
    gen_config_files
}
