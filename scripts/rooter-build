#!/bin/sh
# ROOter model-driven build wrapper for OpenWrt 25.12.x.
# Supports ALL devices from the 24.10 build system via scripts/rooter-models/router-all.json
# Usage:
#   ./build <MODEL>              # standard image
#   ./build <MODEL>-mwan3        # MWAN3 image
#   ./build -e  <MODEL>          # menuconfig then save
#   ./build -eb <MODEL>          # menuconfig then build
#   ./build -b  <MODEL>          # build from saved config
#   ./build LIST                 # list all models
#   ./buildz8  <MODEL>           # convenience alias
#   ./buildz8c <MODEL>           # convenience alias

set -eu

ROOT="$(CDPATH= cd -- "$(dirname "$(readlink -f "$0")")/.." && pwd)"
MODEL_DB="${MODEL_DB:-$ROOT/scripts/rooter-models/router-all.json}"
CONFIG_DIR="$ROOT/.rooter/configs"
JOBS="${ROOTER_JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)}"
DATE="$(date +%Y-%m-%d)"
STAMP="GO$DATE"

die()   { echo "ERROR: $*" >&2; exit 1; }
warn()  { echo "WARN:  $*" >&2; }
usage() {
    cat >&2 <<EOF
ROOter 25.12 build wrapper

Usage:
  $0 <MODEL>              build standard image
  $0 <MODEL>-mwan3        build MWAN3 image
  $0 -e  <MODEL>          edit config (menuconfig) then save
  $0 -eb <MODEL>          edit config then build
  $0 -b  <MODEL>          build from previously saved config
  $0 LIST                 list all available models

Models are defined in: scripts/rooter-models/router-all.json
Unavailable models (missing DTS in 25.12) are in the _UNAVAILABLE_IN_25 section.
EOF
    exit 2
}

[ -f "$MODEL_DB" ] || die "missing model database: $MODEL_DB"
command -v python3 >/dev/null 2>&1 || die "python3 is required on the build host"

#--------------------------------------------------------------------
# JSON helpers
#--------------------------------------------------------------------
_json_model() {
    python3 - "$1" "$2" "$3" <<'PY'
import json, sys
db = json.load(open(sys.argv[1]))
models = db.get("models", db)
model = sys.argv[2].upper()
key = sys.argv[3]
m = models.get(model)
if not m:
    sys.exit(1)
v = m.get(key)
if v is None:
    sys.exit(1)
print(v)
PY
}

_json_list() {
    python3 - "$MODEL_DB" <<'PY'
import json, sys
db = json.load(open(sys.argv[1]))
models = db.get("models", db)
for k, v in sorted(models.items()):
    if k.startswith("_"):
        continue
    details = v.get("details", "")
    target  = v.get("target", "?")
    sub     = v.get("subtarget", "?")
    print(f"  {k:<20}  {target}/{sub:<22}  {details}")
PY
}

_unavailable_list() {
    python3 - "$MODEL_DB" <<'PY'
import json, sys
db = json.load(open(sys.argv[1]))
models = db.get("models", db)
u = models.get("_UNAVAILABLE_IN_25", {})
for k, v in sorted(u.items()):
    if k.startswith("_"):
        continue
    print(f"  {k:<20}  {v.get('details','')}  (port DTS first: {v.get('dts','')})")
PY
}

model_field() { _json_model "$MODEL_DB" "$1" "$2"; }

package_exists() {
    grep -RqsE "^define Package/${1}([[:space:]]|$)" \
        "$ROOT/package" "$ROOT/feeds" 2>/dev/null
}

#--------------------------------------------------------------------
# Model selection
#--------------------------------------------------------------------
select_model() {
    RAW="$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"
    MWAN3=0
    case "$RAW" in
        *-MWAN3)
            MODEL="${RAW%-MWAN3}"
            MWAN3=1
            ;;
        *)
            MODEL="$RAW"
            ;;
    esac

    # Validate model exists
    python3 - "$MODEL_DB" "$MODEL" <<'PY' || die "Unknown model: $MODEL"
import json, sys
db = json.load(open(sys.argv[1]))
models = db.get("models", db)
m = sys.argv[2]
if m not in models or m.startswith("_"):
    sys.exit(1)
PY

    TARGET="$(model_field "$MODEL" target)"
    SUBTARGET="$(model_field "$MODEL" subtarget)"
    PROFILE="$(model_field "$MODEL" profile)"
    CONFIG_NAME="$(model_field "$MODEL" config)"
    OUTPUT_NAME="$(model_field "$MODEL" output)"
    IMAGE_SYSUPGRADE="$(model_field "$MODEL" image_sysupgrade)"
    BUILD_TYPE="$(model_field "$MODEL" build_type 2>/dev/null || true)"
    if [ "$MWAN3" -eq 1 ]; then
        ROOTER_PKG="$(model_field "$MODEL" mwan3_package)"
    else
        ROOTER_PKG="$(model_field "$MODEL" rooter_package)"
    fi
}

#--------------------------------------------------------------------
# .config preparation
#--------------------------------------------------------------------
prepare_config() {
    echo "==> Target  : $TARGET/$SUBTARGET"
    echo "==> Profile : $PROFILE"
    echo "==> Model   : $MODEL  variant=$([ "$MWAN3" -eq 1 ] && echo MWAN3 || echo standard)"
    echo "==> Package : $ROOTER_PKG"

    make defconfig >/dev/null 2>&1

    {
        echo "CONFIG_TARGET_${TARGET}=y"
        echo "CONFIG_TARGET_${TARGET}_${SUBTARGET}=y"
        echo "CONFIG_TARGET_${TARGET}_${SUBTARGET}_DEVICE_${PROFILE}=y"
        if package_exists "$ROOTER_PKG"; then
            echo "CONFIG_PACKAGE_${ROOTER_PKG}=y"
        else
            warn "package $ROOTER_PKG not found in feeds – skipping"
        fi
    } >> .config

    make defconfig >/dev/null 2>&1
}

#--------------------------------------------------------------------
# Build and copy image
#--------------------------------------------------------------------
do_build() {
    echo "==> Building ($JOBS jobs)..."
    make -j"$JOBS" V=s

    mkdir -p "$ROOT/images"
    suffix=""
    [ "$MWAN3" -eq 1 ] && suffix="-MWAN3"
    dst="$ROOT/images/${OUTPUT_NAME}${suffix}-${STAMP}-upgrade.bin"

    # Locate the sysupgrade image
    src=""
    for dir in \
        "$ROOT/bin/targets/$TARGET/$SUBTARGET" \
        "$ROOT/bin/targets/$TARGET/$SUBTARGET/"; do
        candidate="$dir/$IMAGE_SYSUPGRADE"
        if [ -f "$candidate" ]; then
            src="$candidate"
            break
        fi
    done
    [ -n "$src" ] || die "Image not found: $IMAGE_SYSUPGRADE  (looked in bin/targets/$TARGET/$SUBTARGET/)"

    cp -f "$src" "$dst"

    cat > "$ROOT/images/${OUTPUT_NAME}${suffix}-${STAMP}.manifest" <<EOF
model=$MODEL
variant=$([ "$MWAN3" -eq 1 ] && echo MWAN3 || echo standard)
details=$(model_field "$MODEL" details)
target=$TARGET/$SUBTARGET
profile=$PROFILE
rooter_package=$ROOTER_PKG
openwrt_commit=$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)
image=$IMAGE_SYSUPGRADE
output=$(basename "$dst")
build_date=$DATE
EOF
    echo "==> Image: $dst"
}

#--------------------------------------------------------------------
# High-level actions
#--------------------------------------------------------------------
action_build() {
    select_model "$1"
    cd "$ROOT"
    prepare_config
    do_build
}

action_edit() {
    select_model "$1"
    name="${2:-$CONFIG_NAME}"
    cfg="$CONFIG_DIR/${name}.config"
    mkdir -p "$CONFIG_DIR"
    cd "$ROOT"
    if [ -f "$cfg" ]; then
        cp "$cfg" .config
    else
        prepare_config
    fi
    make menuconfig
    cp .config "$cfg"
    echo "==> Saved config: $cfg"
}

action_build_saved() {
    select_model "$1"
    name="${2:-$CONFIG_NAME}"
    cfg="$CONFIG_DIR/${name}.config"
    [ -f "$cfg" ] || die "No saved config for $MODEL at $cfg (run -e first)"
    cd "$ROOT"
    cp "$cfg" .config
    make defconfig >/dev/null 2>&1
    do_build
}

action_list() {
    echo "Available models:"
    _json_list
    echo ""
    echo "Unavailable (DTS not yet in 25.12 – port DTS before building):"
    _unavailable_list
}

#--------------------------------------------------------------------
# Entry point
#--------------------------------------------------------------------
[ $# -ge 1 ] || usage

case "$1" in
    LIST|list)
        action_list
        ;;
    -e)
        [ $# -ge 2 ] || usage
        action_edit "$2" "${3:-}"
        ;;
    -eb)
        [ $# -ge 2 ] || usage
        action_edit "$2" "${3:-}"
        action_build_saved "$2" "${3:-}"
        ;;
    -b)
        [ $# -ge 2 ] || usage
        action_build_saved "$2" "${3:-}"
        ;;
    *)
        action_build "$1"
        ;;
esac
